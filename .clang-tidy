Checks: >
  bugprone-*,
  clang-analyzer-*,
  misc-include-cleaner,
  modernize-use-nullptr,
  modernize-use-override,
  readability-identifier-naming,
  -bugprone-reserved-identifier,
  -bugprone-narrowing-conversions,
  -bugprone-easily-swappable-parameters,
  -bugprone-std-namespace-modification,
  -bugprone-switch-missing-default-case,
  -bugprone-integer-division,
  -bugprone-too-small-loop-variable,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-macro-parentheses,
  -bugprone-branch-clone,
  -clang-analyzer-security.insecureAPI.*,
  -clang-analyzer-core.NullPointerArithm,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-security.ArrayBound,
  -clang-diagnostic-*
HeaderFilterRegex: '(^|/)(src|interfaces)/'
SystemHeaders: false
CheckOptions:
  readability-identifier-naming.ClassCase: 'CamelCase'
  readability-identifier-naming.ClassIgnoredRegexp: '^((.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.StructCase: 'CamelCase'
  readability-identifier-naming.StructIgnoredRegexp: '^(host_[A-Za-z0-9_]+|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.UnionCase: 'CamelCase'
  readability-identifier-naming.UnionIgnoredRegexp: '^((.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.EnumCase: 'CamelCase'
  readability-identifier-naming.EnumIgnoredRegexp: '^((.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.TypedefCase: 'CamelCase'
  readability-identifier-naming.TypedefIgnoredRegexp: '^((.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.FunctionCase: 'CamelCase'
  readability-identifier-naming.FunctionIgnoredRegexp: '^(HAPI_[A-Za-z0-9_]+|host_[A-Za-z0-9_]+|sort|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.MethodCase: 'CamelCase'
  readability-identifier-naming.MethodIgnoredRegexp: '^(v[0-9]+|unused[0-9]*|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.MemberCase: 'camelBack'
  readability-identifier-naming.MemberIgnoredRegexp: '^(g_[A-Za-z0-9_]+|(bits|flags?|arg|b[0-9]|f[0-9a-f]*)_[A-Za-z0-9_]+|[A-Z][A-Za-z0-9_]*|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.VariableCase: 'camelBack'
  readability-identifier-naming.VariableIgnoredRegexp: '^((.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.ParameterCase: 'camelBack'
  readability-identifier-naming.ParameterIgnoredRegexp: '^([a-z0-9]+(_[a-z0-9]+)+|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.GlobalVariableCase: 'camelBack'
  readability-identifier-naming.GlobalVariablePrefix: 'g_'
  readability-identifier-naming.GlobalVariableIgnoredRegexp: '^(s_[A-Za-z0-9_]+|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.GlobalConstantCase: 'CamelCase'
  readability-identifier-naming.GlobalConstantPrefix: 'k'
  readability-identifier-naming.GlobalConstantIgnoredRegexp: '^(g_[A-Za-z0-9_]+|s_[A-Za-z0-9_]+|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.MacroDefinitionCase: 'UPPER_CASE'
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^(g_[A-Za-z0-9_]+|(.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
  readability-identifier-naming.EnumConstantCase: 'UPPER_CASE'
  readability-identifier-naming.EnumConstantIgnoredRegexp: '^((.*_[0-9a-fA-F]{2,8}|_.*|(FUN|DAT)_.*|field_.*|unk.*|param_.*|SimType_.*))$'
