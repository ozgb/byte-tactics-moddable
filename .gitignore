# Microsoft's compiler and the game binary must never be committed.
/toolchain
/orig/*
!/orig/*.sha256
/build/
*.obj
*.exe
*.pdb
*.ilk

.venv/
__pycache__/

# Per-issue working copies (tools/worktree.sh).
/.worktrees/

# The human's ntfy.sh topic (tools/notify.py): whoever knows it can read it.
/NTFY_TOPIC

# Compiler listings (/Fa) from agents; never part of the source.
src/**/*.asm

# /Gi incremental state, if a build ever writes it in the root
vc50.idb

TotalA.exe
/tests/wasm/modules/rust/target/
