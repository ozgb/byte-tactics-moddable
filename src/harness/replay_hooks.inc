bool IsImportOf(unsigned owner, unsigned slot)
{
    switch (owner) {
    case SUB_WIND_METEORS:
        if (slot == RSL_WEAPONS_SPAWNPROJECTILE)
            return true;
        if (slot == RSL_WEAPONS_FINDWEAPONBYNAME)
            return true;
        if (slot == RSL_FILES_BANKOPENACCOUNT)
            return true;
        if (slot == RSL_FILES_BANKSETINTEGER)
            return true;
        if (slot == RSL_FILES_BANKGETINTEGER)
            return true;
        return false;
    case SUB_ECONOMY:
        if (slot == RSL_UNITS_SETSTATEBITS)
            return true;
        if (slot == RSL_UNITS_STARTSCRIPTWITHARGS)
            return true;
        if (slot == RSL_LOS_RADAR_GETMAPCELL)
            return true;
        if (slot == RSL_NETWORK_SENDSHAREMAPINFO)
            return true;
        if (slot == RSL_PLAYERS_TRANSFERENERGY)
            return true;
        if (slot == RSL_PLAYERS_TRANSFERMETAL)
            return true;
        if (slot == RSL_FILES_BANKOPENNAMEDBOX)
            return true;
        if (slot == RSL_FILES_BANKSEEKBOX)
            return true;
        if (slot == RSL_FILES_BANKREADBOX)
            return true;
        if (slot == RSL_FILES_BANKWRITEBOX)
            return true;
        return false;
    case SUB_TARGETING:
        if (slot == RSL_AI_GETVISIBLEENEMIESINRADIUS)
            return true;
        if (slot == RSL_WEAPONS_GETWEAPONRANGE)
            return true;
        if (slot == RSL_WEAPONS_WEAPONCANREACHUNIT)
            return true;
        if (slot == RSL_UNITS_FINDSCRIPT)
            return true;
        if (slot == RSL_UNITS_STARTSCRIPTWITHARGS)
            return true;
        if (slot == RSL_UNITS_GETGROUNDHEIGHT)
            return true;
        if (slot == RSL_UNITS_GETSWEETSPOT)
            return true;
        return false;
    default:
        return false;
    }
}

