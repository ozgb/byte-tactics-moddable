(module
  (import "env" "memory" (memory 1))
  (import "calc_host" "Mix" (func $mix (param i32 i32) (result i32)))
  (import "calc_host" "Neg" (func $neg (param i32 i32) (result i32)))
  (import "calc_host" "Mul" (func $mul (param i32) (result i32)))
  (import "calc_host" "Note" (func $note (param i32) (result i32)))
  (import "calc_host" "Tick" (func $tick (param i32)))
  (import "calc_host" "Echo" (func $echo (param i32) (result i32)))
  (func (export "Swap") (param i32 i32) (result i32)
    local.get 0 i32.const 1000 i32.mul local.get 1 i32.add)
  (func (export "Add3") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.add)
  (func (export "Scale") (param i32 i32) (result i32)
    local.get 0 local.get 1 i32.mul)
  (func (export "Count") (param i32))
  (func (export "Poke") (param i32) (result i32)
    (i32.store (i32.const 65552) (local.get 0))
    (i32.add (local.get 0) (i32.const 1)))
  (func (export "Same") (param i32) (result i32)
    local.get 0 i32.const 1 i32.add)
  (func (export "RunMix") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $mix)
  (func (export "RunNeg") (param i32) (result i32)
    local.get 0 i32.const 99 call $neg)
  (func (export "RunMul") (param i32) (result i32)
    local.get 0 call $mul)
  (func (export "RunNote") (param i32) (result i32)
    local.get 0 call $note)
  (func (export "RunTick") (param i32) (result i32)
    local.get 0 call $tick local.get 0)
  (func (export "RunEcho") (param i32) (result i32)
    local.get 0 call $echo))
